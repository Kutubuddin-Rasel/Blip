generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User{
  id  String  @id @default(uuid())  @db.Uuid
  firebaseUid String? @unique
  name String
  phoneNumber String?  @unique
  avatar String?
  hashedRefreshToken  String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  messages Message[]
  conversations  Conversation[]
  blocksMade Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")
}

model Block {
  id String @id @default(uuid()) @db.Uuid
  blockerId String @db.Uuid
  blockedId String @db.Uuid
  createdAt DateTime @default(now())
  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Message{
  id  String @id @default(uuid()) @db.Uuid
  clientMessageId String @db.Uuid
  content String
  createdAt DateTime @default(now())
  userId  String  @db.Uuid
  user  User  @relation(fields: [userId],references: [id])
  conversationId  String  @db.Uuid
  conversation  Conversation  @relation(fields: [conversationId],references: [id])
  @@index([conversationId,createdAt])
  @@unique([userId,clientMessageId])
}

model Conversation{
  id  String  @id @default(uuid())  @db.Uuid
  directKey String? @unique
  name String?
  messages  Message[]
  users User[]
  lastMessageAt DateTime?
  @@index([lastMessageAt])
}
